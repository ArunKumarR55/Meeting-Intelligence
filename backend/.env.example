# Gemini API keys. Create keys in separate Google Cloud projects to get
# independent project-level request quotas. When a specialized key is empty,
# that workload falls back to GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_ANALYSIS_API_KEY=
GEMINI_SEARCH_API_KEY=

# Follow-through reminder scheduler
REMINDERS_ENABLED=true
REMINDERS_INTERVAL_MINUTES=60
REMINDER_TIMEZONE=Asia/Kolkata

# OAuth callback URLs use {AMIP_PUBLIC_BASE_URL}/api/v1/calendar/{provider}/callback
AMIP_PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key stable; changing it prevents AMIP from decrypting saved calendar tokens.
CALENDAR_TOKEN_ENCRYPTION_KEY=

# Google Cloud Console OAuth web application credentials
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Microsoft Entra app registration credentials
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_TENANT=common

# AssemblyAI API key is used for live streaming and uploaded-file transcription.
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_SPEECH_MODEL=universal-3-pro
ASSEMBLYAI_TRANSCRIPTION_TIMEOUT_SECONDS=1800
ASSEMBLYAI_POLL_INTERVAL_SECONDS=3

# Jira Cloud issue sync (create an API token in your Atlassian account settings)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
